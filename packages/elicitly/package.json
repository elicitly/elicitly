{
  "name": "elicitly",
  "version": "0.6.0",
  "mcpName": "ai.elicitly/elicitly",
  "description": "Local (stdio) MCP server that gives your prompts and Agent Skills MCP elicitation \u2014 human-in-the-loop dialogs (elicit_confirm, elicit_form) and the elicit_doctor capability report, with no server of your own.",
  "keywords": [
    "mcp",
    "elicitation",
    "human-in-the-loop",
    "mcp-server",
    "model-context-protocol",
    "agent-skills"
  ],
  "license": "Apache-2.0",
  "author": "Preneur LLC",
  "homepage": "https://www.elicitly.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elicitly/elicitly.git",
    "directory": "packages/elicitly"
  },
  "bugs": "https://github.com/elicitly/elicitly/issues",
  "type": "module",
  "bin": {
    "elicitly": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@elicitly/tools": "workspace:*",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
