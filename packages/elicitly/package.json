{
  "name": "elicitly",
  "version": "0.7.2",
  "mcpName": "ai.elicitly/elicitly",
  "description": "Local (stdio) MCP server that gives your prompts and Agent Skills MCP elicitation — human-in-the-loop dialogs (elicit_confirm, elicit_form) and the elicit_doctor capability report, with no server of your own.",
  "keywords": [
    "mcp",
    "elicitation",
    "human-in-the-loop",
    "mcp-server",
    "model-context-protocol",
    "agent-skills"
  ],
  "license": "Apache-2.0",
  "author": "Preneur LLC",
  "homepage": "https://www.elicitly.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elicitly/elicitly.git",
    "directory": "packages/elicitly"
  },
  "bugs": "https://github.com/elicitly/elicitly/issues",
  "type": "module",
  "bin": {
    "elicitly": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "build:mcpb": "tsdown && node scripts/build-mcpb.mjs && mcpb validate dist-mcpb/bundle/manifest.json && mcpb pack dist-mcpb/bundle dist-mcpb/elicitly.mcpb",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@elicitly/tools": "workspace:*",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
