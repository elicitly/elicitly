{
  "name": "@elicitly/tools",
  "version": "0.4.1",
  "description": "Embeddable MCP elicitation toolkit — register elicit_confirm, elicit_form, and elicit_doctor on any McpServer, plus the elicitation-schema types and capability report/probe layer.",
  "keywords": [
    "mcp",
    "elicitation",
    "human-in-the-loop",
    "mcp-server",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "author": "Preneur LLC",
  "homepage": "https://www.elicitly.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elicitly/elicitly.git",
    "directory": "packages/tools"
  },
  "bugs": "https://github.com/elicitly/elicitly/issues",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
