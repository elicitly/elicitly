{
  "name": "elicitly-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check": "biome check",
    "check:fix": "biome check --write",
    "release": "pnpm run build && pnpm -r publish --access public --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@changesets/cli": "^3.0.0",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
